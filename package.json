{
  "name": "formercial",
  "version": "0.0.0",
  "description": "Make short product commercials from programmable scenes: live preview, recorded or generated voice, MP4 in 16:9, 9:16 and 1:1.",
  "license": "Apache-2.0",
  "author": "Felix Orinda",
  "repository": {
    "type": "git",
    "url": "https://github.com/forinda/formercial.git"
  },
  "keywords": [
    "video",
    "commercial",
    "ad",
    "kickjs",
    "ffmpeg",
    "text-to-speech",
    "motion-graphics"
  ],
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "kick dev",
    "build": "kick build && vite build --config vite.client.config.ts && vite build --config vite.client.config.ts --ssr src/client/ssr.tsx",
    "start": "kick start",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@forinda/kickjs": "^10.14.0",
    "@forinda/kickjs-inertia": "^0.4.0",
    "@forinda/kickjs-schema": "^0.2.4",
    "@forinda/kickjs-storage": "^0.4.0",
    "@inertiajs/core": "^3.9.1",
    "@inertiajs/react": "^3.9.1",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@forinda/kickjs-cli": "^8.17.2",
    "@forinda/kickjs-testing": "^8.3.1",
    "@forinda/kickjs-vite": "^8.5.1",
    "@swc/core": "^1.16.20",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "commander": "^15.0.0",
    "happy-dom": "^21.0.4",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "unplugin-swc": "^2.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
