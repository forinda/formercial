{
  "name": "formercial",
  "version": "0.2.1",
  "description": "Make short product commercials from programmable scenes: live preview, recorded or generated voice, MP4 in 16:9, 9:16 and 1:1.",
  "license": "Apache-2.0",
  "author": "Felix Orinda",
  "repository": {
    "type": "git",
    "url": "https://github.com/forinda/formercial.git"
  },
  "keywords": [
    "video",
    "commercial",
    "ad",
    "kickjs",
    "ffmpeg",
    "text-to-speech",
    "motion-graphics"
  ],
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "kick dev",
    "build": "kick build && vite build --config vite.client.config.ts && vite build --config vite.client.config.ts --ssr src/client/ssr.tsx",
    "start": "kick start",
    "test": "vitest run --passWithNoTests && pnpm test:scripts",
    "docs:dev": "vitepress dev site",
    "docs:build": "vitepress build site",
    "docs:preview": "vitepress preview site",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@forinda/kickjs": "^10.14.0",
    "@forinda/kickjs-db": "^8.12.4",
    "@forinda/kickjs-inertia": "^0.4.0",
    "@forinda/kickjs-mcp": "^9.1.2",
    "@forinda/kickjs-schema": "^0.2.4",
    "@forinda/kickjs-storage": "^0.4.0",
    "@inertiajs/core": "^3.9.1",
    "@inertiajs/react": "^3.9.1",
    "@modelcontextprotocol/server": "^2.4.0",
    "@tabler/icons-react": "^3.50.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.15.1",
    "reflect-metadata": "^0.2.2",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@forinda/kickjs-cli": "^8.17.2",
    "@forinda/kickjs-devtools": "^7.19.0",
    "@forinda/kickjs-testing": "^8.3.1",
    "@forinda/kickjs-vite": "^8.5.1",
    "@swc/core": "^1.16.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "commander": "^15.0.0",
    "happy-dom": "^21.0.4",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "unplugin-swc": "^2.0.0",
    "vite": "^8.3.5",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  }
}
