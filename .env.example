# Generated by `kick env example` from the env schema and the declared settings
# sections. Re-run it after changing them; `kick env example --check` fails when stale.
#
# Uncommented variables are required. Commented ones are optional; the value shown
# is the default. Any variable can come from a file instead: NAME_FILE=/run/secrets/name

# ── App env schema ──
# PORT=3000
# NODE_ENV=development
# LOG_LEVEL=info
# SESSION_SECRET=dev-only-session-secret-not-for-production
# APP_URL=http://localhost:3000

# ── FORMERCIAL settings (declared by app) ──
# Where projects live, and defaults for new projects and renders
# Folder holding the projects
# FORMERCIAL_PROJECTS=projects
# Where trust for custom scenes is kept, outside the projects folder; default ~/.config/formercial/trust.json
# FORMERCIAL_TRUST_FILE=
# Where project history is kept; default under .formercial/, which git ignores
# FORMERCIAL_HISTORY_FILE=
# Voice for new projects
# FORMERCIAL_VOICE=en-US-AvaNeural
# Render frame rate unless a render asks for another, 1 to 60
# FORMERCIAL_FPS=30
# Render driver unless a render asks for another
# FORMERCIAL_DRIVER=chromium-ffmpeg
# Set by kick formercial render on its own server: no hot reload
# FORMERCIAL_RENDER=false

# ── S3 settings (optional, declared by adapter StorageAdapter) ──
# Bucket name — required when used
# S3_BUCKET=
# Access key; set with S3_SECRET_ACCESS_KEY, or neither and pass credentials to s3FromSettings() (an IAM role)
# S3_ACCESS_KEY_ID=
# Secret for S3_ACCESS_KEY_ID
# S3_SECRET_ACCESS_KEY=
# Region, e.g. eu-west-1 (auto for Cloudflare R2); default us-east-1
# S3_REGION=
# Endpoint of an S3-compatible service (Cloudflare R2, MinIO); unset for AWS
# S3_ENDPOINT=
# Session token for temporary credentials
# S3_SESSION_TOKEN=
# <endpoint>/<bucket>/<key> addressing; default true with S3_ENDPOINT, false for AWS
# S3_FORCE_PATH_STYLE=
